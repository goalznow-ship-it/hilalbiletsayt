generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userBranchRoles UserBranchRole[]

  @@map("roles")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userBranchRoles UserBranchRole[]

  registrations ExaminationRegistration[]
  tickets       Ticket[]

  candidates    Candidate[]

  @@index([isActive])
  @@map("branches")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  fullName       String
  passwordHash   String
  isActive       Boolean  @default(true)
  tokenVersion   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userBranchRoles UserBranchRole[]

  tickets       Ticket[]

  @@index([isActive])
  @@map("users")
}

model UserBranchRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  branchId  String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userId, branchId, roleId])
  @@index([userId])
  @@index([branchId])
  @@index([roleId])
  @@map("user_branch_roles")
}

model Exam {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  title       String
  description String?
  /// Ticket price in integer qəpik (1 AZN = 100 qəpik).
  /// null = not configured; 0 = explicitly free.
  price       Int?
  status      String   @default("DRAFT")
  createdBy   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  sessions      ExamSession[]
  registrations ExaminationRegistration[]
  tickets       Ticket[]
  questions     Question[]
  omrKeys       OmrAnswerKey[]
  omrUploads    OmrUpload[]

  @@map("exams")
}

model Question {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @db.Uuid
  question    String
  /// Variantlar A-E formatında saxlanyar, "|" ilə ajratılır
  variants    String   /// "A) cavab1|B) cavab2|C) cavab3|D) cavab4|E) cavab5"
  correct     Int      /// 1-indexli düzgün cavab nömrəsi (1-5)
  points      Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  exam        Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@map("questions")
}

model ExamSession {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @db.Uuid
  sessionCode String
  startsAt    DateTime
  endsAt      DateTime
  venue       String?
  capacity    Int      @default(100)
  status      String   @default("PLANNED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  exam          Exam                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  registrations ExaminationRegistration[]
  tickets       Ticket[]

  @@index([examId])
  @@map("exam_sessions")
}

model Candidate {
  id               String   @id @default(uuid()) @db.Uuid
  candidate_number String   @unique
  full_name        String
  /// Case-insensitive uniqueness is enforced by the candidates_email_lower_key migration index.
  email            String?
  phone            String?
  is_active        Boolean  @default(true)
  branch_id        String?  @db.Uuid
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now()) @updatedAt

  branch        Branch?                 @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  registrations ExaminationRegistration[]
  tickets       Ticket[]

  @@index([branch_id])
  @@map("candidates")
}

model ExaminationRegistration {
  id            String   @id @default(uuid()) @db.Uuid
  candidate_id  String   @db.Uuid
  exam_id       String   @db.Uuid
  session_id    String   @db.Uuid
  branch_id     String?  @db.Uuid
  status        String   @default("PENDING")
  registered_at DateTime @default(now())

  candidate Candidate   @relation(fields: [candidate_id], references: [id], onDelete: Restrict)
  exam      Exam        @relation(fields: [exam_id], references: [id], onDelete: Restrict)
  session   ExamSession @relation(fields: [session_id], references: [id], onDelete: Restrict)
  branch    Branch?     @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  @@unique([candidate_id, session_id], map: "examination_registrations_candidate_session_key")
  @@index([candidate_id])
  @@index([exam_id])
  @@index([session_id])
  @@index([branch_id])
  @@map("examination_registrations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([timestamp])
  @@map("audit_logs")
}

model Ticket {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  examId      String   @db.Uuid @map("exam_id")
  sessionId   String?  @db.Uuid @map("session_id")
  candidateId String?  @db.Uuid @map("candidate_id")
  branchId    String?  @db.Uuid @map("branch_id")
  sellerId    String?  @db.Uuid @map("seller_id")
  /// Recorded sale price in integer qəpik (1 AZN = 100 qəpik).
  price       Int
  status      String   @default("ACTIVE")
  type        String   @default("STANDARD")
  qrCode      String   @map("qr_code")
  registeredAt DateTime @default(now()) @map("registered_at")
  usedAt      DateTime? @map("used_at")
  usedBy      String?   @map("used_by")
  paymentStatus String   @default("PENDING") // PENDING, PAID, REFUNDED
  paymentMethod String?  
  paymentDate  DateTime?
  notes        String?
  purchaseKey  String? @unique @db.Uuid
  purchaseHash String?
  receiptToken String? @unique

  exam        Exam       @relation(fields: [examId], references: [id])
  session     ExamSession? @relation(fields: [sessionId], references: [id])
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  branch      Branch?    @relation(fields: [branchId], references: [id])
  seller      User?      @relation(fields: [sellerId], references: [id])
  omrSheet    OmrSheet?

  @@index([examId])
  @@index([sessionId])
  @@index([candidateId])
  @@index([branchId])
  @@index([sellerId])
  @@index([status])
  @@index([paymentStatus])
  @@map("tickets")
}

model OmrAnswerKey {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @db.Uuid
  variant     String
  version     Int
  choiceCount Int
  /// Ordered, immutable snapshots of existing Question IDs, correct choices and points.
  answers     Json
  scoring     Json
  digest      String
  createdAt   DateTime @default(now())
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  sheets      OmrSheet[]
  @@unique([examId, variant, version])
  @@map("omr_answer_keys")
}

model OmrSheet {
  id              String   @id @default(uuid()) @db.Uuid
  token           String   @unique
  ticketId        String   @unique @db.Uuid
  answerKeyId     String   @db.Uuid
  /// Identity at issue time; changed ticket associations must go to review.
  candidateId     String   @db.Uuid
  examId          String   @db.Uuid
  branchId        String   @db.Uuid
  templateVersion String   @default("hilal-a4-v1")
  createdAt       DateTime @default(now())
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  answerKey       OmrAnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Restrict)
  result          OmrPage?
  @@map("omr_sheets")
}

model OmrUpload {
  id          String   @id @default(uuid()) @db.Uuid
  examId      String   @db.Uuid
  createdBy   String   @db.Uuid
  sha256      String
  size        Int
  mime        String
  status      String   @default("PENDING")
  attemptId   String?  @db.Uuid
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Restrict)
  pages       OmrPage[]
  @@unique([examId, createdBy, sha256])
  @@index([createdBy, createdAt])
  @@map("omr_uploads")
}

model OmrPage {
  id          String   @id @default(uuid()) @db.Uuid
  uploadId    String   @db.Uuid
  pageIndex   Int
  sheetId     String?  @unique @db.Uuid
  status      String
  data        Json
  createdAt   DateTime @default(now())
  upload      OmrUpload @relation(fields: [uploadId], references: [id], onDelete: Restrict)
  sheet       OmrSheet? @relation(fields: [sheetId], references: [id], onDelete: Restrict)
  @@unique([uploadId, pageIndex])
  @@map("omr_pages")
}
