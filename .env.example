# Hilal Bilet Sistemi — environment template.
#
# 1. cp .env.example .env
# 2. ./scripts/generate-secrets.sh .env     (replaces every "change-me" value)
# 3. Set PUBLIC_URL / SITE_ADDRESS / BOOTSTRAP_ADMIN_EMAIL for your server.
#
# The API refuses to start in production while any secret still contains
# "change-me" — there are no usable defaults on purpose.

# --- Public address -----------------------------------------------------------
# Browser origin of the site (used for CORS). Real server: https://bilet.example.az
PUBLIC_URL=http://localhost
# Caddy site address. Real server: bilet.example.az (automatic HTTPS).
# ":80" serves plain HTTP for local verification only.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# --- Database -----------------------------------------------------------------
POSTGRES_USER=hilal
POSTGRES_DB=hilal
POSTGRES_PASSWORD=change-me-postgres-password

# --- Secrets (generate with scripts/generate-secrets.sh, min. 32 chars) --------
JWT_SECRET=change-me-jwt-secret-000000000000000000
QR_SIGNING_SECRET=change-me-qr-signing-secret-000000000000
OMR_WORKER_SECRET=change-me-omr-worker-secret-000000000000

# --- First administrator (created once if no SUPER_ADMIN exists) --------------
# Remove BOOTSTRAP_ADMIN_PASSWORD from .env after the first login.
BOOTSTRAP_ADMIN_EMAIL=admin@example.az
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_BRANCH_CODE=MERKEZ
BOOTSTRAP_BRANCH_NAME="Mərkəzi ofis"

# --- Rate limits (per client IP, per minute) -----------------------------------
# Branch offices behind one NAT address share these limits.
API_RATE_LIMIT_PER_MINUTE=300
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Local development without Docker (apps/api reads these) -------------------
# DATABASE_URL=postgresql://hilal:<password>@localhost:5432/hilal
# OMR_WORKER_URL=http://127.0.0.1:8000
# OMR_STORAGE_DIR=var/omr
# CORS_ORIGIN=http://localhost:3000
