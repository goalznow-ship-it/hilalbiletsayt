# Application
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000
# When Next.js is the API's local reverse proxy, trust only its network address.
# Set the actual proxy CIDRs in production; keep API access restricted to that proxy.
API_TRUSTED_PROXIES=loopback

# Database
POSTGRES_USER=hilal
POSTGRES_PASSWORD=hilal
POSTGRES_DB=hilal
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hilal:hilal@localhost:5432/hilal

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=hilal-scans

# OMR worker
OMR_WORKER_URL=http://localhost:8000
