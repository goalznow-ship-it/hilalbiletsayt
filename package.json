{
  "name": "hilal-bilet-sistemi",
  "version": "0.1.0",
  "private": true,
  "description": "Hilal Bilet Sistemi - centralized examination ticket sales and OMR result management",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --recursive build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:migrate": "pnpm --filter @hilal/api prisma:migrate",
    "db:generate": "pnpm --filter @hilal/api prisma:generate"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
